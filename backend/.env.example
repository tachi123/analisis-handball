# Public Google Sheet used only by the local report publisher.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=PublicReports

# Set exactly one local credential source. Keep the service-account JSON outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Docker resolves this path inside the backend container via ./backend:/app.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json
# Local file-publisher workflow (copy backend/.env.local.example to backend/.env).
# Keep Google credentials in a separate configuration; never mix them with file mode.
# APP_ENV=development
# REPORT_PUBLISHER=file
# LOCAL_PUBLIC_REPORT_FILE=/app/data/public-report.json
