# Copy to backend/.env for the safe local file-publisher workflow.
# Use non-default values before the first startup; never commit backend/.env.
SUPERADMIN_EMAIL=local-admin@example.test
SUPERADMIN_PASSWORD=replace-with-a-unique-local-password
APP_ENV=development
REPORT_PUBLISHER=file
LOCAL_PUBLIC_REPORT_FILE=/app/data/public-report.json
